# ===== 腾讯云元宝搜索（必填）=====
# 控制台创建密钥：https://console.cloud.tencent.com/cam/capi
# 开通元宝搜索：https://console.cloud.tencent.com/wsapi/index
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 搜索模式：0 自然结果 / 1 VR 卡 / 2 自然结果+VR 卡（默认 2；若当前版本不支持会自动去掉重试）
WSA_MODE=2

# ===== 摘要用 LLM（必填，任意 OpenAI 兼容接口）=====
# DeepSeek 示例：LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# 硅基流动示例：LLM_BASE_URL=https://api.siliconflow.cn/v1  LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 复制本文件为 web/.env.local 并填入真实值；.env.local 已被 .gitignore 排除，严禁提交
